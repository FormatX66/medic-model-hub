# Copy to .env and fill in the keys you want to enable.
# Only backends with a key set are advertised. This file is yours —
# bundles never overwrite .env.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=
# Free web search for the hub (Sonar grounding). Optional:
# - Set BRAVE_SEARCH_API_KEY for Brave Search API free tier (2,000 queries/month,
#   no card: https://brave.com/search/api/). Leave empty and the hub uses
#   DuckDuckGo keyless Instant Answer API instead.
BRAVE_SEARCH_API_KEY=
# - SONAR_WEB_SEARCH=1 opts back into Perplexity's own web_search tool on Sonar
#   calls (per-call fee). Default 0: hub grounds Sonar with its free search.
SONAR_WEB_SEARCH=0
# IBM Quantum (QPU gateway). Optional: only /v1/qpu/* needs these.
IBM_QUANTUM_API_KEY=
IBM_QUANTUM_CRN=
# Optional QPU tuning:
# QPU_REGION=us-east
# QPU_BACKENDS=ibm_kingston,ibm_fez,ibm_marrakesh
# QPU_MAX_SHOTS=1024
# QPU_LEDGER=data/qpu_ledger.json
# QPU_HTTP_CLIENT: urllib (default) or curl. Use curl when IBM's
# Cloudflare edge bans the hub with HTTP 1010 browser_signature_banned —
# curl's TLS fingerprint is browser-like; Python's stdlib signature is
# what gets banned. Requires curl in the image (the Dockerfile installs
# it). Falls back to urllib automatically if curl is missing.
#QPU_HTTP_CLIENT=curl
# Azure Quantum gateway (/v1/azure/*). Optional: only /v1/azure/* needs these.
# Auth is Microsoft Entra client-credentials (service principal with Quantum
# workspace access). The connection-string ApiKey is parsed but never sent.
#AZURE_QUANTUM_CONNECTION_STRING=
#AZURE_TENANT_ID=
#AZURE_CLIENT_ID=
#AZURE_CLIENT_SECRET=
# Azure workspace location, e.g. eastus (only needed if the connection
# string lacks a QuantumEndpoint entry).
#AZURE_QUANTUM_LOCATION=
# Target allowlist — EMPTY by default: submits refuse until you name targets,
# e.g. ionq.simulator,quantinuum.sim.h1-1e
#AZURE_QUANTUM_TARGETS=
#AZURE_QUANTUM_MAX_SHOTS=1024
#AZURE_QPU_LEDGER=data/azure_qpu_ledger.json
# Google Quantum Engine gateway (/v1/google/*). Optional: only /v1/google/*
# needs these. OAuth refresh-token flow (stdlib-safe); RS256 service-account
# signing is NOT implemented.
#GOOGLE_QUANTUM_PROJECT_ID=
# OAuth desktop-client credentials (one-time browser flow; store the
# refresh token), or a pre-minted short-lived bearer:
#GOOGLE_QUANTUM_CLIENT_ID=
#GOOGLE_QUANTUM_CLIENT_SECRET=
#GOOGLE_QUANTUM_REFRESH_TOKEN=
#GOOGLE_QUANTUM_ACCESS_TOKEN=
# Processor allowlist — EMPTY by default: submits refuse until you name
# processors, e.g. sycamore_weber
#GOOGLE_QUANTUM_PROCESSORS=
#GOOGLE_QUANTUM_MAX_REPETITIONS=1024
#GOOGLE_QPU_LEDGER=data/google_qpu_ledger.json
