# Copy to .env and fill in the keys you want to enable.
# Only backends with a key set are advertised. This file is yours —
# bundles never overwrite .env.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=
# Free web search for the hub (Sonar grounding). Optional:
# - Set BRAVE_SEARCH_API_KEY for Brave Search API free tier (2,000 queries/month,
#   no card: https://brave.com/search/api/). Leave empty and the hub uses
#   DuckDuckGo keyless Instant Answer API instead.
BRAVE_SEARCH_API_KEY=
# - SONAR_WEB_SEARCH=1 opts back into Perplexity's own web_search tool on Sonar
#   calls (per-call fee). Default 0: hub grounds Sonar with its free search.
SONAR_WEB_SEARCH=0
# IBM Quantum (QPU gateway). Optional: only /v1/qpu/* needs these.
IBM_QUANTUM_API_KEY=
IBM_QUANTUM_CRN=
# Optional QPU tuning:
# QPU_REGION=us-east
# QPU_BACKENDS=ibm_kingston,ibm_fez,ibm_marrakesh
# QPU_MAX_SHOTS=1024
# QPU_LEDGER=data/qpu_ledger.json
