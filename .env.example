# Copy to .env and fill in the keys you want to enable.
# Only backends with a key set are advertised. This file is yours —
# bundles never overwrite .env.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=
# IBM Quantum (QPU gateway). Optional: only /v1/qpu/* needs these.
IBM_QUANTUM_API_KEY=
IBM_QUANTUM_CRN=
# Optional QPU tuning:
# QPU_REGION=us-east
# QPU_BACKENDS=ibm_kingston,ibm_fez,ibm_marrakesh
# QPU_MAX_SHOTS=1024
# QPU_LEDGER=data/qpu_ledger.json
